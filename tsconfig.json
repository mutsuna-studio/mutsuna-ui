{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "paths": {
      "@mutsuna/ui": ["./src/lib/index.ts"],
      "@mutsuna/ui/*": ["./src/lib/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["svelte"]
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.svelte", "stories/**/*.svelte", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
