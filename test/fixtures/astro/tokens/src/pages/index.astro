---
import "@mutsuna/ui/tokens.css";
import { findThemeTemplate, themeToCssVariables } from "@mutsuna/ui/theme/core";

const github = themeToCssVariables(findThemeTemplate("github"))
  .filter(([, value]) => value !== null)
  .map(([name, value]) => `${name}: ${value}`).join(";");
---
<!doctype html>
<html lang="ja">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Astro theme tokens</title></head>
  <body>
    <h1>Astro theme tokens</h1>
    <section id="base" class="panel">標準テーマ</section>
    <section id="github" class="panel" style={github}>GitHub-inspired</section>
  </body>
</html>
<style>
  body { margin: 2rem; background: var(--background); color: var(--foreground); }
  .panel { padding: 1rem; margin-block: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--background); color: var(--foreground); }
</style>
